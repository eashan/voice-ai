# Provider keys (never commit .env)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# Orchestrator
ORCHESTRATOR_PORT=8787
DEMO_ENABLED=true
# Shared secret used by web (signs) and orchestrator (verifies) session JWTs
SESSION_JWT_SECRET=change-me
DEMO_INVITE_CODE=change-me
MAX_CONCURRENT_SESSIONS=2
MAX_CALL_SECONDS=180
DAILY_MINUTE_BUDGET=60

# Web
NEXT_PUBLIC_ORCHESTRATOR_WS_URL=ws://localhost:8787/ws

# Cloudflare Turnstile (optional). When BOTH are set, the concierge is open to anyone who passes the bot check;
# until then it asks for DEMO_INVITE_CODE.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
